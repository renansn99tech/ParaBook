# Django
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# PostgreSQL local. Em produção, use a connection string do Supabase.
DATABASE_URL=postgres://parabook_user:parabook_password@localhost:5432/parabook_db
DATABASE_CONN_MAX_AGE=600
DATABASE_DISABLE_SERVER_SIDE_CURSORS=False
SERVERLESS=False

# Supabase Storage S3 (obrigatório em produção; mantenha o bucket privado).
SUPABASE_STORAGE_ENABLED=False
SUPABASE_STORAGE_BUCKET_NAME=parabook-media
SUPABASE_STORAGE_ENDPOINT=https://SEU_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=SUA_REGIAO
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_URL_EXPIRY=900

# Cookies: Lax funciona com app/api no mesmo domínio raiz. Para hosts
# realmente cross-site, use None junto de Secure=True (com limitações de Safari).
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# SMTP fica desligado no Render Free, que bloqueia as portas usuais.
EMAIL_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=nao-responda@parabook.com.br

# Pagamentos permanecem bloqueados até decisão comercial explícita.
PAYMENTS_ENABLED=False
