# Django
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Produção com domínio próprio: ex. parabook.com.br, sem esquema ou caminho.
PUBLIC_SITE_DOMAIN=
SHARED_SITE_ENFORCED=False
TERMS_VERSION=2026-09-30
LEGAL_DOCUMENTS_REVIEWED=False
LEGAL_CONTROLLER_TYPE=pessoa_fisica
LEGAL_CONTROLLER_NAME=ParaBook — projeto em validação
LEGAL_CONTROLLER_ADDRESS=
LEGAL_PRIVACY_CONTACT=
# G5: chave Fernet dedicada de provas segregadas, distinta de SECRET_KEY.
# Gerar e guardar no ambiente/custódia de chaves; nunca versionar o valor real.
PRIVACY_EVIDENCE_KEY=
PRIVACY_EVIDENCE_KEY_ID=v1

# PostgreSQL local. Em produção, use a connection string do Supabase.
DATABASE_URL=postgres://parabook_user:parabook_password@localhost:5432/parabook_db
DATABASE_CONN_MAX_AGE=600
DATABASE_DISABLE_SERVER_SIDE_CURSORS=False
SERVERLESS=False
RUN_MIGRATIONS=False
RUN_SEED_ACERVO=False
RUN_SEED_ADMIN=False

# Obrigatórias somente quando RUN_SEED_ADMIN=True. Não versione valores reais.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Supabase Storage S3 (obrigatório em produção; mantenha o bucket privado).
SUPABASE_STORAGE_ENABLED=False
SUPABASE_STORAGE_BUCKET_NAME=parabook-media
SUPABASE_STORAGE_ENDPOINT=https://SEU_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=SUA_REGIAO
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_URL_EXPIRY=900

# Cookies: Lax funciona com app/api no mesmo domínio raiz. Para hosts
# realmente cross-site, use None junto de Secure=True (com limitações de Safari).
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# SMTP fica desligado no Render Free, que bloqueia as portas usuais.
EMAIL_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=nao-responda@parabook.com.br

# Pagamentos permanecem bloqueados até decisão comercial explícita.
PAYMENTS_ENABLED=False

# Preparação G2/G4. Não ativar no hosting por inferência.
AGE_POLICY_ACTIVE=False
AGE_POLICY_ROLLOUT_AT=
AGE_POLICY_VERSION=idade-v1
BOOK_FILE_SCAN_REQUIRED=False
BOOK_CLAMSCAN_PATH=
BOOK_SCAN_TIMEOUT_SECONDS=30
BOOK_SCAN_DATABASE_DIR=
BOOK_SCAN_MAX_AGE_HOURS=24
BOOK_SCAN_SIGNATURE_MAX_AGE_HOURS=72
# Exclusivo de ensaio DEBUG=True; assinatura privada de teste não homologa Talos.
BOOK_SCAN_ALLOW_TEST_DATABASE=False
BOOK_RIGHTS_REQUIRED=False
BOOK_DISTRIBUTION_TERRITORY=BR
# JSON de chave_id -> chave pública Ed25519 base64. Nunca colocar chave privada.
BOOK_VAULT_PUBLIC_KEYS={}
